<view class="page"><view class="header"><text class="brand" bindtap="home">✦ 微光群岛</text><text class="tag">运动冒险 · 实验版</text></view><view wx:if="{{atHome}}"><view class="eyebrow">慢慢出发，也会抵达</view><view class="title">你的微光群岛</view><view class="card island-card" wx:for="{{gameCards}}" wx:key="id"><view class="eyebrow">{{item.islandLabel}}</view><view class="heading">{{item.gameTitle}}</view><view class="hint">{{item.description}}</view><view class="hint" wx:if="{{!item.loadError}}">{{item.damage}} / {{item.total}} · {{item.totalActions}} 次 · {{item.roundCount}} 轮</view><button bindtap="openGame" data-level="{{item.id}}" disabled="{{blocked || item.loadError}}" class="primary">{{item.screen === 'win' ? '查看已完成旅程' : '进入这座岛'}}</button></view></view><block wx:elif="{{v}}"><view class="eyebrow">{{v.islandLabel}} · {{v.stageName}} · 阶段 {{v.stage}} / 3</view><view class="title">{{v.screen === 'ready' ? v.gameTitle : v.screen === 'battle' ? v.gameTitle : v.screen === 'rest' ? '休息一下' : v.screen === 'stageClear' ? '这一阶段完成了' : v.gameTitle + '已点亮'}}</view><view class="subtitle">随时休息，进度会留在这里。</view><view class="row shields" wx:if="{{v.screen === 'battle'}}"><view class="shield" wx:for="{{v.targets}}" wx:key="label"><view>{{item.label}} {{item.hp}} / {{item.maxHp}}</view><progress percent="{{item.percent}}" activeColor="#267b64" stroke-width="5"/></view></view><view class="game-art {{v.screen}}" wx:if="{{!v.standing}}"><image class="art-island" src="/assets/island-v1.png" mode="aspectFit"/><image class="art-guardian {{fxDamage ? 'pulse' : ''}}" src="/assets/guardian-v1.png" mode="aspectFit"/><image class="art-lantern" src="/assets/lantern-v1.png" mode="aspectFit"/><view class="damage-fx" wx:if="{{fxDamage}}">+{{fxDamage}}</view><view class="sparkles" wx:if="{{v.screen === 'win' || v.screen === 'stageClear'}}">✧　✦　✧</view></view><view class="standing-scene {{v.screen}}" wx:if="{{v.standing}}"><view class="standing-moon">✦</view><view class="standing-destination">远方的灯台</view><view class="standing-path"><view wx:for="{{v.steps}}" wx:key="number" class="path-step {{item.lit ? 'lit' : ''}}">{{item.lit ? '✦' : '·'}}</view></view><view class="standing-caption">{{v.stageName}} · {{v.damage}} / {{v.total}}</view><view class="standing-fx" wx:if="{{fxDamage}}">+{{fxDamage}} 微光</view></view><view class="card state" wx:if="{{v.screen === 'ready'}}"><view class="heading">先从你舒服的节奏开始</view><view wx:if="{{v.standing}}" class="picker">{{v.exerciseLabel}}</view><picker wx:if="{{!v.standing}}" range="{{profiles}}" value="{{profileIndex}}" bindchange="profile" disabled="{{blocked}}"><view class="picker">{{profiles[profileIndex]}} ▾</view></picker><view class="hint">{{v.instruction}}</view><view class="hint">按钮可模拟体验；摄像头识别仍需真机校准。</view><button bindtap="start" disabled="{{blocked}}" class="primary">开始这一轮</button><button bindtap="startCamera" disabled="{{blocked || recognitionLoading}}">{{recognitionLoading ? '正在加载模型…' : '摄像头' + v.exerciseLabel + ' · 实验功能'}}</button><button bindtap="help">查看玩法</button></view><view class="card state" wx:elif="{{v.screen === 'battle'}}"><view class="action-count">{{v.roundActions}}<text> 次</text></view><view class="hint">本轮 {{v.sourceLabel}}</view><view class="row metrics"><text>本轮贡献 {{v.roundDamage}}</text><text>微光能量 {{v.skills}} / 2</text></view><view class="row"><button bindtap="skill" data-skill="focus" disabled="{{blocked || !v.skills}}">☀ 聚光 +10</button><button bindtap="skill" data-skill="split" disabled="{{blocked || !v.skills}}">✧ 散光</button></view><view class="hint">{{v.skillLabel ? '已选择' + v.skillLabel + '，下次动作触发' : '每4次动作获得1份能量，最多2份'}}</view><button wx:if="{{v.sourceLabel === '按钮模拟'}}" bindtap="hit" disabled="{{blocked}}" class="primary">模拟完成 1 次动作</button><button bindtap="pause" disabled="{{blocked}}">休息一下</button></view><view class="card state" wx:elif="{{v.screen === 'rest'}}"><view class="state-icon">☾</view><view class="heading">休息一下，微光还在</view><view class="round-summary">本轮 {{v.roundActions}} 次 · 贡献 {{v.roundDamage}}</view><view class="saved" wx:if="{{!blocked}}">✓ 进度已保存</view><button bindtap="resume" disabled="{{blocked}}" class="primary">继续这一轮</button><button bindtap="end" disabled="{{blocked}}">结束本轮并保存</button><view class="hint">不用赶，准备好了再继续。</view></view><view class="card state" wx:elif="{{v.screen === 'stageClear'}}"><view class="state-icon">✦</view><view class="heading">{{v.standing ? '这一段栈道亮起来了' : '第一束微光，亮起来了'}}</view><view class="round-summary">本轮 {{v.roundActions}} 次 · 贡献 {{v.roundDamage}}</view><view class="stage-dots"><text class="lit">✦</text><text class="{{v.stage >= 2 ? 'lit' : ''}}">✦</text><text>✦</text></view><view class="hint">下一阶段：{{v.nextStage}}</view><view class="transition-card" wx:if="{{v.standing}}"><view class="heading">接下来：{{v.exerciseLabel}}</view><view class="hint">{{v.instruction}} 不用换机位，准备好再继续。</view></view><button bindtap="advance" disabled="{{blocked}}" class="primary">{{v.standing ? '准备好了，进入' + v.exerciseLabel : v.activeRound ? '进入下一阶段' : '按钮体验进入下一阶段'}}</button><button wx:if="{{!v.activeRound}}" bindtap="startCamera" disabled="{{blocked || recognitionLoading}}">摄像头进入下一阶段 · 实验</button><button wx:if="{{v.activeRound}}" bindtap="end" disabled="{{blocked}}">先休息，保留进度</button><view wx:else class="hint">本轮已结束，下次可以继续下一阶段。</view></view><view class="card state" wx:else><view class="heading">{{v.standing ? '栈道连通，灯台已点亮' : '岛屿已经亮起来了'}}</view><view class="win-summary">总计 {{v.totalActions}} 次 · {{v.roundCount}} 轮完成</view><view class="history row" wx:for="{{v.rounds}}" wx:key="id"><text>第 {{item.number}} 轮</text><text>{{item.actions}} 次</text><text>贡献 {{item.damage}}</text></view><view class="hint">输入来源见每轮记录</view><button bindtap="home" class="primary">返回群岛</button><button bindtap="records">查看本次记录</button></view><view class="progress-card"><view class="row"><text>累计贡献</text><text>{{v.damage}} / {{v.total}}</text></view><progress percent="{{v.percent}}" activeColor="#267b64" stroke-width="7"/><view class="hint">累计 {{v.totalActions}} 次动作 · {{v.roundCount}} 轮</view></view></block><view id="save-failure" class="card failure" wx:if="{{blocked}}"><view class="heading">保存失败，先休息一下</view><view class="hint">已停止计数，请保留页面并重试保存。</view><button bindtap="retry" class="primary">重试保存</button></view><view class="error">{{error}}</view><button bindtap="records" class="text-button">{{showRecords ? '收起记录' : '我们的每一轮'}}</button><view class="card" wx:if="{{showRecords}}"><view class="history" wx:for="{{v.rounds}}" wx:key="id">第 {{item.number}} 轮 · {{item.actions}} 次 · 贡献 {{item.damage}}<view class="hint">{{item.profileLabel}} · {{item.sourceLabel}} · {{item.sealed ? '已结束' : '进行中'}}</view></view><view wx:if="{{!v.roundCount}}" class="hint">还没有记录，慢慢开始就好。</view></view><view class="footer">不倒计时 · 不会死亡 · 分多轮通关<view>记录保存在当前设备；清除数据会删除记录。</view></view><button class="text-button" bindtap="toggleProbe">{{showProbe ? '收起摄像头面板' : '摄像头与识别状态'}}</button><view id="camera-panel" class="card" wx:if="{{showProbe}}"><view class="heading">{{cameraMode === 'recognition' ? v.exerciseLabel + '识别 · 实验功能' : '摄像头诊断'}}</view><view class="hint">画面仅在设备上处理，不上传或保存。{{v.instruction}} 请单人入镜。</view><block wx:if="{{cameraMode === 'recognition'}}"><view class="action-count">{{v.roundActions}}<text> 次</text></view><view class="heading">{{recognitionMessage}}</view><view class="transition-card" wx:if="{{v.screen === 'stageClear'}}"><view class="heading">下一段：{{v.exerciseLabel}}</view><view class="hint">{{v.instruction}}</view><button bindtap="advance" disabled="{{blocked || recognitionLoading}}" class="primary">准备好了，继续下一段</button></view><view class="hint">本轮贡献 {{v.roundDamage}} · 累计 {{v.damage}} / {{v.total}}</view></block><button bindtap="openCamera" wx:if="{{!cameraVisible}}">仅测试摄像头取帧</button><camera wx:if="{{cameraVisible}}" device-position="front" frame-size="small" bindinitdone="cameraReady" binderror="cameraError"/><button wx:if="{{cameraVisible}}" bindtap="closeCamera" class="primary">休息并关闭摄像头</button><view class="probe">{{probe}}</view><button bindtap="copyDiagnostics">复制诊断结果</button></view></view>
